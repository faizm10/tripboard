# Copy to .env.local. Anything left blank keeps that part of Tripboard in demo mode.

# Neon Postgres. Use the direct (non-pooled) connection string from the Neon console.
DATABASE_URL=

# Neon Auth. The cookie secret must be at least 32 characters: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Email allowed to open /admin.
ADMIN_EMAIL=

# Mapbox: the public token renders the map, the server token powers directions.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# Google Places (New) + Geocoding, server-only. Foursquare is the fallback.
GOOGLE_MAPS_API_KEY=
FOURSQUARE_API_KEY=

# Trip assistant via OpenRouter. OPENROUTER_MODELS is optional (comma-separated).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Encrypts the OpenAI, Anthropic and Gemini keys people save on their account. At least 32 characters: openssl rand -base64 32
# Changing it makes saved keys unreadable, and people will need to add them again.
AI_KEYS_SECRET=

# Optional: uptime history on /status from Google Cloud Monitoring. See docs/gcp-integration.md.
# The key is a read-only (roles/monitoring.viewer) service-account key file, as raw JSON or base64.
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# Optional: Vercel deployments on /admin/platform. Create a team-scoped token at
# vercel.com/account/settings/tokens.
# The project and team come from Vercel's OIDC token; set these two only to override it.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
